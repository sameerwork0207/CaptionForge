# CaptionForge backend configuration. Copy to backend/.env and adjust.
# Real environment variables override values in this file. All are optional.

# ── Speech model ──────────────────────────────────────────────────────────────
# tiny | base | small | medium | large-v3 | distil-large-v3 | a local model path
WHISPER_MODEL=base
# cpu (default) | cuda | auto (try CUDA, fall back to CPU)
WHISPER_DEVICE=cpu
# int8 is fastest on CPU; float16 is typical on GPU. Defaults: cpu→int8, cuda/auto→float16.
# WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# Where models are downloaded/cached (default: the Hugging Face cache in your user profile)
# WHISPER_MODEL_DIR=

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=500
MAX_DURATION_SECONDS=10800
FFMPEG_TIMEOUT_SECONDS=600
# Pending + processing jobs allowed at once (jobs run one at a time)
MAX_QUEUED_JOBS=20

# ── Storage ───────────────────────────────────────────────────────────────────
# Relative paths are resolved against backend/
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
# Finished jobs (captions + metadata) are deleted this many hours after finishing; 0 = keep
JOB_RETENTION_HOURS=24

# ── Caption segmentation ──────────────────────────────────────────────────────
CAPTION_MAX_CHARS_PER_LINE=42
CAPTION_MAX_LINES=2
CAPTION_MAX_CPS=17
CAPTION_MIN_DURATION=1.0
CAPTION_MAX_DURATION=7.0
CAPTION_PAUSE_SPLIT=0.6

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API (the frontend URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
